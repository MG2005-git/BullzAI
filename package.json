{
  "name": "bullz-ai",
  "version": "0.2.0",
  "private": true,
  "description": "BullzAI: Institutional-grade real-time stock intelligence, AI market sentiment, and interactive charts for Indian markets.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "generate:icons": "node scripts/generateIcons.mjs",
