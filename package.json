    "verify:indices": "node scripts/verifyIndexSymbols.mjs",
    "verify:news": "node scripts/verifyNews.mjs",
    "test": "node scripts/testMatching.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
